      "outputs": [],
      "source": [
        "# Setup (not from the book): download the data files\n",
        "!wget -q -nc https://raw.githubusercontent.com/iamtrask/Grokking-Deep-Learning/master/reviews.txt\n",
        "!wget -q -nc https://raw.githubusercontent.com/iamtrask/Grokking-Deep-Learning/master/labels.txt"
      ],
      "id": "c11-code-setup-data"
