      "source": [
        "import math\n",
        "import sys\n",
        "import numpy as np\n",
        "from collections import Counter\n",
        "\n",
        "alpha, iterations = (0.05, 2)\n",
        "hidden_size, window, negative = (50, 2, 5)\n",
        "\n",
        "weights_0_1 = (np.random.rand(len(vocab), hidden_size) - 0.5) * 0.2\n",
        "weights_1_2 = np.random.rand(len(vocab), hidden_size) * 0\n",
        "\n",
        "layer_2_target = np.zeros(negative + 1)\n",
        "layer_2_target[0] = 1.0\n",
        "\n",
        "index2word = {i: w for w, i in word2index.items()}\n",
        "\n",
        "def sigmoid(x):\n",
        "  return 1 / (1 + np.exp(-x))\n",
        "\n",
        "def similar(target='beautiful', top_n=10):\n",
        "  if target not in word2index:\n",
        "    return []\n",
        "  target_index = word2index[target]\n",
        "\n",
        "  diff = weights_0_1 - weights_0_1[target_index]\n",
        "  distances = -np.sqrt(np.sum(diff**2, axis=1))\n",
        "\n",
        "  top_indices = np.argsort(distances)[::-1][:top_n]\n",
        "  return [(index2word[i], distances[i]) for i in top_indices]\n",
        "\n",
        "total_reviews = len(input_dataset) * iterations\n",
        "len_concatenated = len(concatenated)\n",
        "\n",
        "for rev_i, review in enumerate(input_dataset * iterations):\n",
        "  for target_i in range(len(review)):\n",
        "    context = review[max(0, target_i - window) : target_i] + review[\n",
        "        target_i + 1 : min(len(review), target_i + window)\n",
        "    ]\n",
        "    if not context:\n",
        "      continue\n",
        "\n",
        "    neg_indices = concatenated[\n",
        "        np.random.randint(0, len_concatenated, size=negative)\n",
        "    ]\n",
        "    target_samples = [review[target_i]] + neg_indices.tolist()\n",
        "\n",
        "    layer_1 = np.mean(weights_0_1[context], axis=0)\n",
        "    layer_2 = sigmoid(layer_1.dot(weights_1_2[target_samples].T))\n",
        "\n",
        "    layer_2_delta = layer_2 - layer_2_target\n",
        "    layer_1_delta = layer_2_delta.dot(weights_1_2[target_samples])\n",
        "\n",
        "    weights_0_1[context] -= layer_1_delta * alpha\n",
        "    weights_1_2[target_samples] -= np.outer(layer_2_delta, layer_1) * alpha\n",
        "\n",
        "  if rev_i % 100 == 0 or rev_i == total_reviews - 1:\n",
        "    progress = (rev_i + 1) / float(total_reviews)\n",
        "    sys.stdout.write(f'\\rProgress: {progress * 100:.2f}%')\n",
        "    sys.stdout.flush()\n",
        "\n",
        "print('\\n\\nTraining Selesai!')\n",
        "print('Kata terdekat dengan \"terrible\":')\n",
        "print(similar('terrible'))"
      ],
      "id": "c11-code-fill-train"
