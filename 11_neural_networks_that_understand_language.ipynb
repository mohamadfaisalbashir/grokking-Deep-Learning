      "cell_type": "code",
      "execution_count": 9,
      "metadata": {
        "id": "c11-code-fill-train",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 373
        },
        "outputId": "87d8d1a1-6eb8-470d-c39a-90341bf00e5f"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Progress: 3.80%"
          ]
